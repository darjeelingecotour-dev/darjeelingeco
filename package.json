{
  "name": "sarkartravel",
  "version": "1.0.0",
  "description": "SarkarTravels — Curated Darjeeling, Sikkim, Assam and Himalayan journeys",
  "type": "module",
  "scripts": {
    "dev:11ty": "eleventy --serve",
    "dev:css": "npx tailwindcss -i ./src/assets/css/styles.css -o ./_site/assets/css/styles.css --watch",
    "dev": "npm-run-all -p dev:11ty dev:css",
    "build:css": "npx tailwindcss -i ./src/assets/css/styles.css -o ./_site/assets/css/styles.css --minify",
    "build:11ty": "eleventy",
    "build": "npm-run-all build:css build:11ty",
    "clean": "rimraf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "js-yaml": "^4.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "rimraf": "^5.0.0"
  },
  "keywords": [
    "travel",
    "darjeeling",
    "sikkim",
    "assam",
    "northeast-india",
    "eleventy",
    "static-site"
  ],
  "license": "MIT"
}
