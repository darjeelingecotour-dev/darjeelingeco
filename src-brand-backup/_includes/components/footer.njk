<footer class="bg-forest text-white">
  <div class="container mx-auto px-4 py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="{{ '/' | htmlBaseUrl }}" class="brand-lockup brand-lockup-footer mb-6" aria-label="Safar Saathi home">
          {% include "components/brand-wordmark.njk" %}
        </a>
        <p class="max-w-sm text-white/70">Personalized domestic and international holidays, thoughtfully planned around you.</p>
        <p class="mt-4 text-sm font-semibold text-primary-300">Bharat Se Duniya Tak</p>
      </div>

      <div>
        <h2 class="mb-5 text-base font-bold uppercase tracking-wider">Explore</h2>
        <ul class="space-y-3 text-white/70">
          <li><a class="footer-link" href="{{ '/' | htmlBaseUrl }}">Home</a></li>
          <li><a class="footer-link" href="{{ '/destinations/' | htmlBaseUrl }}">Destinations</a></li>
          <li><a class="footer-link" href="{{ '/tours/' | htmlBaseUrl }}">Tour Packages</a></li>
          <li><a class="footer-link" href="{{ '/gallery/' | htmlBaseUrl }}">Travel Gallery</a></li>
          <li><a class="footer-link" href="{{ '/about/' | htmlBaseUrl }}">About Safar Saathi</a></li>
          <li><a class="footer-link" href="{{ '/#partner-with-us-title' | htmlBaseUrl }}">Partner With Us</a></li>
        </ul>
      </div>

      <div>
        <h2 class="mb-5 text-base font-bold uppercase tracking-wider">Plan Your Trip</h2>
        <ul class="space-y-3 text-white/70">
          <li><a class="footer-link" href="{{ '/contact/#enquiry-form' | htmlBaseUrl }}">Send an Enquiry</a></li>
          <li><a class="footer-link" href="{{ '/contact/' | htmlBaseUrl }}">Contact Us</a></li>
          <li><a class="footer-link" href="https://api.whatsapp.com/send?phone={{ site.whatsapp }}&amp;text=Hello%2C%20I%20would%20like%20help%20planning%20a%20trip." target="_blank" rel="sponsored noopener noreferrer">Chat on WhatsApp</a></li>
          <li><a class="footer-link" href="{{ '/privacy/' | htmlBaseUrl }}">Privacy Policy</a></li>
          <li><a class="footer-link" href="{{ '/terms/' | htmlBaseUrl }}">Terms of Service</a></li>
        </ul>
      </div>

      <div>
        <h2 class="mb-5 text-base font-bold uppercase tracking-wider">Contact</h2>
        <address class="space-y-4 not-italic text-white/70">
          <p class="flex items-start gap-3"><span aria-hidden="true">📍</span><span>{{ site.address }}</span></p>
          <p class="flex items-center gap-3"><span aria-hidden="true">📞</span><a class="footer-link" href="tel:+918240158027">{{ site.phone }}</a></p>
          <p class="flex items-start gap-3"><span aria-hidden="true">✉️</span><a class="footer-link break-all" href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        </address>
        <div class="mt-7 flex flex-col items-start gap-3">
          <a href="{{ '/contact/#enquiry-form' | htmlBaseUrl }}" class="btn-primary">Get a Free Quote</a>
          <a href="https://api.whatsapp.com/send?phone={{ site.whatsapp }}&amp;text=Hello%2C%20I%20would%20like%20information%20about%20your%20travel%20packages." target="_blank" rel="sponsored noopener noreferrer" class="inline-flex items-center gap-2 font-bold text-primary-300 hover:text-yellow-300"><span aria-hidden="true">💬</span>WhatsApp Us</a>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/15 pt-6 text-sm text-white/55 md:flex-row md:items-center md:justify-between">
      <p>&copy; 2026 {{ site.name }}. All rights reserved.</p>
      <p>{{ site.tagline }}</p>
    </div>
  </div>
</footer>
