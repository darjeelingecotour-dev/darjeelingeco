---
layout: layouts/base.njk
title: "Contact Safar Saathi | Plan Your Journey"
metaDescription: "Contact Safar Saathi for personalized domestic and international tours, hotels, transport and holiday planning."
permalink: /contact/
---

<section class="bg-gray-50 pb-24 pt-28">
  <div class="container mx-auto px-4">
    <header class="mx-auto mb-14 max-w-3xl text-center">
      <p class="eyebrow">Plan Your Next Journey</p>
      <h1 class="font-heading text-4xl font-bold text-forest md:text-6xl">Get in Touch</h1>
      <p class="mt-5 text-lg leading-8 text-gray-600 md:text-xl">Tell us where you want to go, your preferred dates and your travel style. Safar Saathi will help you shape a suitable domestic or international holiday.</p>
    </header>

    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-2">
      <section class="rounded-3xl border border-gray-100 bg-white p-7 shadow-card md:p-10" aria-labelledby="enquiry-heading">
        <h2 id="enquiry-heading" class="font-heading text-3xl font-bold text-forest">Send Us a Message</h2>
        <p class="mt-3 text-gray-600">Fields marked with an asterisk are required.</p>

        <form id="enquiry-form" action="https://formsubmit.co/ajax/darjeelingecotour@gmail.com" method="POST" class="inquiry-form mt-8 space-y-6">
          <input type="hidden" name="_subject" value="New Safar Saathi travel enquiry">
          <input type="hidden" name="_template" value="table">
          <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off">

          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label for="contact-name" class="form-label">Your Name *</label>
              <input id="contact-name" type="text" name="name" autocomplete="name" required class="form-input">
            </div>
            <div>
              <label for="contact-email" class="form-label">Email Address *</label>
              <input id="contact-email" type="email" name="email" autocomplete="email" required class="form-input">
            </div>
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label for="contact-phone" class="form-label">Phone Number</label>
              <input id="contact-phone" type="tel" name="phone" autocomplete="tel" inputmode="tel" class="form-input">
            </div>
            <div>
              <label for="contact-subject" class="form-label">Subject</label>
              <select id="contact-subject" name="subject" class="form-input">
                <option value="General Enquiry">General Enquiry</option>
                <option value="Tour Package">Tour Package</option>
                <option value="Custom Holiday">Custom Holiday</option>
                <option value="Festive Offer Enquiry">Durga Puja Festive Offer</option>
                <option value="Advertising Partnership">Hotel or Homestay Advertising</option>
                <option value="Flight or Bus Assistance">Flight or Bus Assistance</option>
              </select>
            </div>
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label for="contact-destination" class="form-label">Preferred Destination</label>
              <input id="contact-destination" type="text" name="destination" placeholder="For example, Sikkim or Thailand" class="form-input">
            </div>
            <div>
              <label for="contact-date" class="form-label">Approximate Travel Date</label>
              <input id="contact-date" type="date" name="travelDate" class="form-input">
            </div>
          </div>

          <div>
            <label for="contact-message" class="form-label">Message *</label>
            <textarea id="contact-message" name="message" rows="6" required placeholder="Tell us the number of travellers, duration, interests and approximate budget." class="form-input resize-none"></textarea>
          </div>

          <label class="flex items-start gap-3 text-sm leading-6 text-gray-600">
            <input type="checkbox" name="consent" value="yes" required class="mt-1 h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary">
            <span>I agree that Safar Saathi may use these details to respond to my travel enquiry. *</span>
          </label>

          <button type="submit" class="btn-primary w-full text-lg">Send Enquiry</button>
        </form>
      </section>

      <aside class="flex flex-col gap-8" aria-label="Safar Saathi contact information">
        <div class="grid gap-6 sm:grid-cols-2">
          <a href="tel:+918240158027" class="contact-card group">
            <span class="contact-icon" aria-hidden="true">TEL</span>
            <span class="min-w-0">
              <strong class="contact-title">Phone</strong>
              <span class="contact-copy">{{ site.phone }}</span>
            </span>
          </a>

          <a href="mailto:{{ site.email }}" class="contact-card group">
            <span class="contact-icon" aria-hidden="true">MAIL</span>
            <span class="min-w-0 max-w-full">
              <strong class="contact-title">Email</strong>
              <span class="contact-copy break-all text-sm">{{ site.email }}</span>
            </span>
          </a>

          <a href="https://api.whatsapp.com/send?phone={{ site.whatsapp }}&amp;text=Hello%2C%20I%20would%20like%20help%20planning%20a%20trip." target="_blank" rel="noopener noreferrer" class="contact-card group">
            <span class="contact-icon contact-icon-whatsapp" aria-hidden="true">WA</span>
            <span class="min-w-0">
              <strong class="contact-title">WhatsApp</strong>
              <span class="contact-copy">Message Us</span>
            </span>
          </a>

          <div class="contact-card">
            <span class="contact-icon" aria-hidden="true">LOC</span>
            <span class="min-w-0">
              <strong class="contact-title">Office</strong>
              <span class="contact-copy text-sm leading-6">{{ site.address }}</span>
            </span>
          </div>
        </div>

        <div class="rounded-3xl bg-forest p-8 text-white shadow-card">
          <p class="text-sm font-bold uppercase tracking-widest text-yellow-300">Quick Assistance</p>
          <h2 class="mt-3 font-heading text-3xl font-bold">Prefer to chat?</h2>
          <p class="mt-4 leading-7 text-white/75">Send a WhatsApp message with your destination, travel date and group size.</p>
          <a href="https://api.whatsapp.com/send?phone={{ site.whatsapp }}&amp;text=Hello%2C%20I%20would%20like%20help%20planning%20a%20trip." target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex rounded-full bg-green-500 px-6 py-3 font-bold text-white transition hover:bg-green-400">Chat on WhatsApp</a>
        </div>
      </aside>
    </div>
  </div>
</section>
