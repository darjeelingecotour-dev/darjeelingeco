---

layout: layouts/base.njk
title: "Festive Tour Packages | Safar Saathi"
permalink: /tours/

---

{% include "components/festive-offer-message.njk" %}


<div class="pt-16">
    <header class="bg-forest text-white h-64 flex flex-col items-center justify-center relative overflow-hidden">
        <div class="absolute inset-0 bg-hero-gradient opacity-80 z-0"></div>
        <div class="relative z-10 text-center px-4">
            <h1 class="text-4xl md:text-6xl font-heading font-bold mb-4">Explore Our Tours</h1>
            <p class="text-green-100 max-w-xl mx-auto text-lg">Find your perfect Northeast India getaway.</p>
        </div>
    </header>
    
    <section class="py-8 bg-white sticky top-[68px] z-40 border-b border-gray-200 shadow-sm">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="w-full md:w-1/3 relative">
                    <input type="text" id="tour-search" placeholder="Search tours, regions, tags..." class="w-full pl-12 pr-4 py-3.5 rounded-full border border-gray-300 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/50 shadow-sm transition-all text-base bg-gray-50 focus:bg-white">
                    <svg class="w-5 h-5 absolute left-4 top-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
                
                <div class="flex overflow-x-auto w-full md:w-auto pb-2 md:pb-0 gap-3 hide-scrollbar font-medium text-sm" id="region-filters">
                    <button class="filter-btn active whitespace-nowrap px-6 py-2.5 rounded-full bg-primary text-white shadow-sm transition" data-region="all">All</button>
                    <button class="filter-btn whitespace-nowrap px-6 py-2.5 rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition" data-region="Darjeeling">Darjeeling</button>
                    <button class="filter-btn whitespace-nowrap px-6 py-2.5 rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition" data-region="Sikkim">Sikkim</button>
                    <button class="filter-btn whitespace-nowrap px-6 py-2.5 rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition" data-region="Assam">Assam</button>
                    <button class="filter-btn whitespace-nowrap px-6 py-2.5 rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition" data-region="Bengal">Bengal</button>
                    <button class="filter-btn whitespace-nowrap px-6 py-2.5 rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition" data-region="Multi-region">Multi-region</button>
                </div>
            </div>
        </div>
    </section>
    
    <section class="py-20 bg-gray-50 min-h-[50vh]">
        <div class="container mx-auto px-4">
            <div id="tours-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                {% for tour in tours %}
                    {% include "components/tour-card.njk" %}
                {% endfor %}
            </div>
            
            <div id="no-results" class="hidden text-center py-24">
                <div class="text-7xl mb-6">🔍</div>
                <h3 class="text-3xl font-heading text-forest mb-3">No tours found</h3>
                <p class="text-gray-500 mb-8 text-lg">Try adjusting your search or filters.</p>
                <button id="clear-filters" class="text-primary font-bold hover:underline text-lg">Clear all filters</button>
            </div>
        </div>
    </section>
</div>


