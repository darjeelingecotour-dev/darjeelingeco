<footer class="bg-forest-900 text-white pt-20 pb-8 footer-section text-sm">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 mb-16 border-b border-white/10 pb-16">
            <div class="lg:col-span-2">
                <div class="flex items-center gap-3 text-white mb-6">
                    <img src="/assets/images/logo.png" alt="{{ site.name }} Logo" class="h-16 w-auto object-contain">
                    <span class="font-brand text-2xl font-bold tracking-tight">{{ site.name }}</span>
                </div>
                <p class="text-gray-400 mb-8 text-base leading-relaxed">{{ site.tagline or 'Curated Northeast India Journeys with an eco-conscious approach.' }}</p>
                <div class="flex gap-4">
                    <a href="{{ site.social.instagram }}" class="bg-white/10 p-2.5 rounded-full text-white hover:bg-primary transition" aria-label="Instagram">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    </a>
                    <a href="{{ site.social.facebook }}" class="bg-white/10 p-2.5 rounded-full text-white hover:bg-primary transition" aria-label="Facebook">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
                    </a>
                    <a href="{{ site.social.youtube }}" class="bg-white/10 p-2.5 rounded-full text-white hover:bg-primary transition" aria-label="YouTube">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                    </a>
                </div>
            </div>
            
            <div>
                <h4 class="font-bold text-xl mb-6 text-white font-heading">Quick Links</h4>
                <ul class="space-y-4">
                    <li><a href="/" class="text-gray-400 hover:text-primary transition font-medium">Home</a></li>
                    <li><a href="/tours/" class="text-gray-400 hover:text-primary transition font-medium">Tours</a></li>
                    <li><a href="/about/" class="text-gray-400 hover:text-primary transition font-medium">About Us</a></li>
                    <li><a href="/contact/" class="text-gray-400 hover:text-primary transition font-medium">Contact</a></li>
                </ul>
            </div>
            
            <div>
                <h4 class="font-bold text-xl mb-6 text-white font-heading">Popular Tours</h4>
                <ul class="space-y-4">
                    {% for tour in tours | slice(0, 4) %}
                    <li><a href="/tours/{{ tour.slug }}/" class="text-gray-400 hover:text-primary transition font-medium line-clamp-1">{{ tour.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            
            <div>
                <h4 class="font-bold text-xl mb-6 text-white font-heading">Contact Us</h4>
                <ul class="space-y-5 text-gray-400 text-base">
                    <li class="flex items-start gap-4">
                        <span class="text-primary text-xl">📍</span> <span>{{ site.address or 'Kolkata, West Bengal, India' }}</span>
                    </li>
                    <li class="flex items-center gap-4">
                        <span class="text-primary text-xl">📞</span> <a href="tel:{{ site.phone }}" class="hover:text-primary transition">{{ site.phone or '+91 98765 43210' }}</a>
                    </li>
                    <li class="flex items-center gap-4">
                        <span class="text-primary text-xl">✉️</span> <a href="mailto:{{ site.email }}" class="hover:text-primary transition break-all">{{ site.email or 'hello@sarkartravels.com' }}</a>
                    </li>
                    <li class="flex items-center gap-4 mt-2">
                        <a href="https://wa.me/{{ site.whatsapp }}" class="bg-green-600 text-white px-4 py-2 rounded-full hover:bg-green-500 transition font-bold flex items-center gap-2">
                            <span>💬</span> Chat on WhatsApp
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        
        <div class="flex flex-col md:flex-row justify-between items-center text-gray-500 text-sm">
            <p>&copy; 2026 {{ site.name }}. All rights reserved.</p>
            <div class="flex gap-6 mt-4 md:mt-0">
                <a href="/privacy" class="hover:text-white transition">Privacy Policy</a>
                <a href="/terms" class="hover:text-white transition">Terms of Service</a>
            </div>
        </div>
    </div>
</footer>
