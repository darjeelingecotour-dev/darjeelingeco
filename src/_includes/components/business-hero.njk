<section class="relative overflow-hidden bg-forest text-white" aria-labelledby="home-hero-title">
  <img src="{{ '/assets/images/hero-darjeeling.png' | url }}" width="1920" height="1080" alt="Kanchenjunga mountain range and tea gardens near Darjeeling" class="absolute inset-0 h-full w-full object-cover object-center" fetchpriority="high">
  <div class="absolute inset-0 bg-gradient-to-r from-[#05382d]/75 via-[#05382d]/35 to-transparent"></div>
  <div class="container relative mx-auto grid min-h-[625px] items-center gap-8 px-4 py-10 lg:grid-cols-[minmax(0,1fr)_560px] lg:gap-10">
    <div class="max-w-3xl py-6">
      <p class="inline-flex rounded-full border border-white/25 bg-black/20 px-4 py-2 text-sm font-semibold backdrop-blur-sm">Local planning | Transparent pricing | Responsive support</p>
      <h1 id="home-hero-title" class="mt-6 font-heading text-5xl font-bold leading-[1.05] md:text-6xl lg:text-7xl">Transparent Tour Packages <span class="text-green-300">from Kolkata</span></h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-white/90">Plan Darjeeling, Sikkim, Dooars, Sundarban and Kashmir holidays with clear itineraries, price assumptions and inclusions before payment.</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="{{ '/tours/' | url }}" class="inline-flex min-h-[52px] items-center justify-center rounded-xl bg-orange-500 px-7 font-bold text-white shadow-lg hover:bg-orange-600">Browse Packages</a>
        <a href="https://api.whatsapp.com/send?phone={{ site.whatsapp }}&amp;text=Hello%20Safar%20Saathi.%20Please%20help%20me%20plan%20a%20trip." target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[52px] items-center justify-center rounded-xl bg-green-600 px-7 font-bold text-white shadow-lg hover:bg-green-700">Chat on WhatsApp</a>
      </div>
      <nav class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6" aria-label="Homepage shortcuts">
        {% set shortcuts = [{label:'Destinations',url:'/destinations/'},{label:'Packages',url:'/tours/'},{label:'Winter Offers',url:'/offers/'},{label:'Travel Blog',url:'/blog/'},{label:'Group Tours',url:'/group-tours/'},{label:'Contact Us',url:'/contact/'}] %}
        {% for shortcut in shortcuts %}<a href="{{ shortcut.url | url }}" class="flex min-h-[68px] items-center justify-center rounded-xl border border-white/25 bg-black/20 px-3 text-center text-sm font-bold backdrop-blur-sm hover:bg-white hover:text-forest">{{ shortcut.label }}</a>{% endfor %}
      </nav>
    </div>
    <div class="rounded-3xl border border-white/40 bg-white p-6 text-gray-800 shadow-2xl md:p-7">
      <h2 class="font-heading text-3xl font-bold text-forest">Get an Exact Quote for Your Trip</h2>
      <p class="mt-2 text-sm leading-6 text-gray-600">A travel planner will verify current hotel, vehicle, permit and route availability.</p>
      <form action="https://formsubmit.co/ajax/{{ site.email }}" method="POST" class="inquiry-form mt-5" id="homepage-quote-form">
        <input type="hidden" name="subject" value="Homepage Written Quote Request">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="sm:col-span-2"><span class="form-label">Destination</span><select name="destination" class="form-input" required><option value="">Select destination</option><option>Darjeeling</option><option>North Sikkim</option><option>Zuluk and Silk Route</option><option>Dooars</option><option>Sundarban</option><option>Kashmir</option><option>Other</option></select></label>
          <label><span class="form-label">Start date</span><input type="date" name="start_date" class="form-input" data-start-date required></label>
          <label><span class="form-label">End date</span><input type="date" name="end_date" class="form-input" data-end-date required></label>
          <div><span class="form-label">Adults</span><div class="flex overflow-hidden rounded-xl border border-gray-300"><button type="button" class="h-12 w-12 font-bold" data-stepper-minus="adults" aria-label="Decrease adults">-</button><input id="adults" name="adults" type="number" min="1" max="30" value="2" class="h-12 min-w-0 flex-1 border-0 text-center font-semibold outline-none"><button type="button" class="h-12 w-12 font-bold" data-stepper-plus="adults" aria-label="Increase adults">+</button></div></div>
          <div><span class="form-label">Children</span><div class="flex overflow-hidden rounded-xl border border-gray-300"><button type="button" class="h-12 w-12 font-bold" data-stepper-minus="children" aria-label="Decrease children">-</button><input id="children" name="children" type="number" min="0" max="20" value="0" class="h-12 min-w-0 flex-1 border-0 text-center font-semibold outline-none"><button type="button" class="h-12 w-12 font-bold" data-stepper-plus="children" aria-label="Increase children">+</button></div></div>
          <label><span class="form-label">Pickup city</span><input name="pickup_city" class="form-input" placeholder="Kolkata, NJP, Srinagar"></label>
          <label><span class="form-label">Hotel category</span><select name="hotel_category" class="form-input"><option>Budget</option><option selected>Comfort</option><option>Premium</option></select></label>
          <label><span class="form-label">Vehicle</span><select name="vehicle" class="form-input"><option>Any suitable option</option><option>Shared vehicle</option><option>Private vehicle</option></select></label>
          <label><span class="form-label">Budget range</span><select name="budget" class="form-input"><option>Flexible</option><option>Below INR 10,000 per person</option><option>INR 10,000 to 20,000 per person</option><option>Above INR 20,000 per person</option></select></label>
          <label class="sm:col-span-2"><span class="form-label">Phone or WhatsApp</span><input type="tel" name="phone" class="form-input" placeholder="Enter mobile number" required></label>
        </div>
        <button type="submit" class="mt-5 min-h-[52px] w-full rounded-xl bg-green-600 px-6 font-bold text-white shadow-md hover:bg-green-700">Get My Written Quote</button>
        <a href="https://api.whatsapp.com/send?phone={{ site.whatsapp }}" target="_blank" rel="noopener noreferrer" class="mt-4 block text-center text-sm font-bold text-green-700">Prefer WhatsApp? Chat with a travel planner</a>
      </form>
    </div>
  </div>
</section>