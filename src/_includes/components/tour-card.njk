<article class="tour-card flex h-full flex-col" data-title="{{ tour.title }}" data-region="{{ tour.region }}" data-tags="{{ tour.tags | join(',') }}">
  <a href="{{ ('/tours/' + tour.slug + '/') | url }}" class="block overflow-hidden" aria-label="View {{ tour.title }} package details">
    <img src="{{ tour.image | url }}" width="720" height="480" alt="{{ tour.title }} travel package" class="tour-card-image" loading="lazy" decoding="async">
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2 text-sm"><span class="tag-pill">{{ tour.region }}</span><span aria-label="Rated {{ tour.rating }} out of 5"><span aria-hidden="true">â˜…</span> {{ tour.rating }}</span></div>
    <h3 class="font-heading text-2xl font-bold text-forest"><a href="{{ ('/tours/' + tour.slug + '/') | url }}" class="hover:text-primary">{{ tour.title }}</a></h3>
    <p class="mt-3 line-clamp-3 text-gray-600">{{ tour.shortDescription or tour.metaDescription or tour.highlight }}</p>
    <div class="mt-auto flex items-end justify-between gap-4 border-t border-gray-100 pt-5">
      <div><span class="block text-xs uppercase tracking-wide text-gray-500">Starting from</span><strong class="text-xl text-forest">{{ tour.price | currency }}</strong><span class="block text-xs text-gray-500">per person*</span></div>
      <div class="text-right"><span class="block text-sm text-gray-600">{{ tour.duration }}</span><a href="{{ ('/tours/' + tour.slug + '/') | url }}" class="mt-2 inline-block font-bold text-primary">View details â†’</a></div>
    </div>
  </div>
</article>

