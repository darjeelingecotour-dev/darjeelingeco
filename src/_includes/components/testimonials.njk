<section class="py-24 bg-forest/5 relative overflow-hidden">
    <div class="container mx-auto px-4">
        <div class="text-center mb-16">
            <span class="section-badge text-primary font-medium tracking-wide uppercase text-sm mb-3 block">Reviews</span>
            <h2 class="section-title text-3xl md:text-5xl font-heading text-forest">What Our Travelers Say</h2>
        </div>
        
        <div class="max-w-4xl mx-auto relative carousel-container group" id="testimonial-carousel">
            <div class="overflow-hidden rounded-3xl bg-white shadow-xl p-8 md:p-16 border border-gray-100">
                <div class="carousel-track flex transition-transform duration-500 ease-in-out">
                    {% for item in testimonials %}
                    <div class="carousel-slide w-full flex-shrink-0 px-4 flex flex-col items-center text-center">
                        <div class="text-yellow-400 text-2xl mb-8 flex gap-1">
                            {% for i in range(0, item.rating) %}⭐{% endfor %}
                        </div>
                        <p class="text-2xl md:text-3xl font-heading italic text-gray-800 mb-10 leading-relaxed max-w-3xl">"{{ item.quote }}"</p>
                        <div class="flex items-center gap-5">
                            {% if item.avatar %}
                                <img src="{{ item.avatar }}" alt="{{ item.name }}" class="w-16 h-16 rounded-full object-cover shadow-md border-2 border-white">
                            {% else %}
                                <div class="w-16 h-16 rounded-full bg-primary text-white flex items-center justify-center font-bold text-2xl shadow-md border-2 border-white">{{ item.name.charAt(0) }}</div>
                            {% endif %}
                            <div class="text-left">
                                <div class="font-bold text-xl text-forest">{{ item.name }}</div>
                                <div class="text-sm font-medium text-gray-500">{{ item.location }} • <span class="text-primary">{{ item.trip }}</span></div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            
            <button class="absolute top-1/2 -left-4 md:-left-6 lg:-left-12 -translate-y-1/2 bg-white w-12 h-12 rounded-full shadow-lg flex items-center justify-center text-forest hover:text-primary hover:bg-gray-50 transition z-10 opacity-0 group-hover:opacity-100" id="carousel-prev" aria-label="Previous">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </button>
            <button class="absolute top-1/2 -right-4 md:-right-6 lg:-right-12 -translate-y-1/2 bg-white w-12 h-12 rounded-full shadow-lg flex items-center justify-center text-forest hover:text-primary hover:bg-gray-50 transition z-10 opacity-0 group-hover:opacity-100" id="carousel-next" aria-label="Next">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </button>
            
            <div class="flex justify-center gap-3 mt-10" id="carousel-dots">
                {% for item in testimonials %}
                    <button class="carousel-dot w-3 h-3 rounded-full bg-gray-300 transition-colors hover:bg-primary/50" data-index="{{ loop.index0 }}" aria-label="Go to slide {{ loop.index }}"></button>
                {% endfor %}
            </div>
        </div>
    </div>
</section
