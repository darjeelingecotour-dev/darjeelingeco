<section class="border-b border-gray-100 bg-white py-6"><div class="container mx-auto grid gap-4 px-4 sm:grid-cols-2 lg:grid-cols-4">{% set promises=[{title:'Written Quotation',text:'Itinerary and quotation before payment.'},{title:'No Hidden Charges',text:'Included, optional and direct-payment costs listed.'},{title:'Best Value Options',text:'Compare Budget, Comfort and Premium choices.'},{title:'Trip Support',text:'A contact point for the confirmed itinerary.'}] %}{% for item in promises %}<article class="flex gap-4 rounded-2xl bg-gray-50 p-5"><span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-green-100 font-bold text-green-700">OK</span><div><h2 class="font-heading text-xl font-bold text-forest">{{ item.title }}</h2><p class="mt-1 text-sm text-gray-600">{{ item.text }}</p></div></article>{% endfor %}</div></section>
<section class="bg-gray-50 py-12"><div class="container mx-auto grid gap-10 px-4 xl:grid-cols-2"><div><div class="mb-5 flex items-end justify-between"><h2 class="font-heading text-3xl font-bold text-forest">Winter Offers 2026-27</h2><a href="{{ '/offers/' | url }}" class="font-bold text-primary">View all offers</a></div><div class="grid gap-5 md:grid-cols-3">{% set offers=[{title:'North Sikkim Winter Escape',price:'10,999',image:'/assets/images/north-sikkim.png',url:'/north-sikkim-tour-packages/'},{title:'Dooars Wildlife Winter Escape',price:'8,499',image:'/assets/images/kaziranga-rhino.png',url:'/dooars-tour-packages/'},{title:'Kashmir Winter Classic',price:'16,999',image:'/assets/images/kashmir-gulmarg-snow.jpg',url:'/tours/kashmir-classic-4n5d/'}] %}{% for offer in offers %}<article class="overflow-hidden rounded-2xl bg-white shadow-card"><img src="{{ offer.image | url }}" alt="{{ offer.title }}" class="h-40 w-full object-cover"><div class="p-4"><h3 class="font-heading text-lg font-bold text-forest">{{ offer.title }}</h3><p class="mt-2 text-sm">From <strong class="text-green-700">INR {{ offer.price }}</strong></p><a href="{{ offer.url | url }}" class="mt-3 inline-block font-bold text-primary">View Offer</a></div></article>{% endfor %}</div></div><div><div class="mb-5 flex items-end justify-between"><h2 class="font-heading text-3xl font-bold text-forest">Our Most Popular Packages</h2><a href="{{ '/tours/' | url }}" class="font-bold text-primary">View all packages</a></div><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{% set popular=[{title:'Darjeeling Classic',price:'7,999',image:'/assets/images/darjeeling-tea.png',url:'/tours/darjeeling-classic/'},{title:'North Sikkim Essential',price:'10,999',image:'/assets/images/north-sikkim.png',url:'/tours/north-sikkim-essential-3n4d/'},{title:'Zuluk Silk Route',price:'5,999',image:'/assets/images/zuluk-road.png',url:'/tours/zuluk-classic-3n4d/'},{title:'Dooars Wildlife Escape',price:'6,499',image:'/assets/images/kaziranga-rhino.png',url:'/tours/dooars-wildlife-3n4d/'},{title:'Sundarban Discovery',price:'5,499',image:'/assets/images/sundarban-mangrove-boat.jpg',url:'/tours/sundarban-weekend-2n3d/'}] %}{% for item in popular %}<article class="overflow-hidden rounded-2xl bg-white shadow-card"><img src="{{ item.image | url }}" alt="{{ item.title }}" class="h-32 w-full object-cover"><div class="p-4"><h3 class="font-heading font-bold text-forest">{{ item.title }}</h3><p class="mt-2 text-sm">From <strong class="text-green-700">INR {{ item.price }}</strong></p><a href="{{ item.url | url }}" class="mt-3 inline-block font-bold text-primary">View Details</a></div></article>{% endfor %}</div></div></div></section>
<section class="bg-white py-12"><div class="container mx-auto px-4"><div class="text-center"><h2 class="font-heading text-3xl font-bold text-forest">How Booking with Safar Saathi Works</h2></div><ol class="mt-8 grid gap-5 md:grid-cols-5">{% set steps=['Share Your Plans','Receive Quote','Customize and Confirm','Pay the Deposit','Receive Trip Support'] %}{% for step in steps %}<li class="rounded-2xl bg-gray-50 p-5"><span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-green-100 font-bold text-green-700">{{ loop.index }}</span><h3 class="mt-4 font-bold text-forest">{{ step }}</h3></li>{% endfor %}</ol></div></section>