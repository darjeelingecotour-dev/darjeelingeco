<section class="py-16 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4 text-center">
        <span class="section-badge text-gray-400 font-medium tracking-wide uppercase text-sm mb-2 block">Our Network</span>
        <h2 class="section-title text-2xl font-heading text-forest mb-10">Our Partners & Certifications</h2>
        
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 items-center justify-items-center opacity-70">
            {% for partner in partners %}
            <div class="group cursor-pointer flex flex-col items-center gap-2" title="{{ partner.description }}">
                <div class="text-5xl grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300">{{ partner.icon }}</div>
                <div class="text-sm font-medium text-forest/70 group-hover:text-forest transition-colors">{{ partner.name }}</div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
