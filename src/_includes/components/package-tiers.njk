<section class="bg-white py-12 md:py-16" aria-labelledby="package-tier-title">
  <div class="container mx-auto px-4">
    <div class="section-heading"><p class="eyebrow">Choose your travel style</p><h2 id="package-tier-title">Budget, Comfort or Premium</h2><p>Compare service levels first, then request the live price for your dates and group.</p></div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {% set tiers = [
        {name:'Budget',copy:'Practical stays and essential services for price-conscious travellers.',items:['Standard hotel or homestay','Essential meal plan','Shared transport where suitable','Clear optional-cost list']},
        {name:'Comfort',copy:'Balanced accommodation, meals and transport for most families and couples.',items:['Comfort-category hotel','Breakfast and dinner','Private vehicle where feasible','More itinerary flexibility']},
        {name:'Premium',copy:'Higher-category stays and private arrangements with added customization.',items:['Premium accommodation','Private transfers','Selected activities','Priority customization']}
      ] %}
      {% for tier in tiers %}<article class="flex h-full flex-col rounded-2xl border {% if tier.name == 'Comfort' %}border-primary bg-primary-50{% else %}border-gray-200 bg-white{% endif %} p-7 shadow-card"><p class="text-sm font-bold uppercase tracking-wider text-primary">{{ tier.name }}</p><h3 class="mt-2 font-heading text-2xl font-bold text-forest">{{ tier.name }} Tour Plan</h3><p class="mt-3 text-gray-600">{{ tier.copy }}</p><ul class="mt-5 space-y-3 text-sm text-gray-700">{% for item in tier.items %}<li class="flex gap-2"><span class="text-primary">&#10003;</span><span>{{ item }}</span></li>{% endfor %}</ul><a href="{{ '/contact/#enquiry-form' | url }}" class="btn-secondary mt-auto pt-3">Get Current {{ tier.name }} Price</a></article>{% endfor %}
    </div>
  </div>
</section>
