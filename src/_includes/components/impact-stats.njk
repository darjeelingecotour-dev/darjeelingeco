<section class="bg-forest text-white py-24 relative overflow-hidden">
    <div class="container mx-auto px-4 text-center relative z-10">
        <span class="section-badge text-accent font-medium tracking-wide uppercase text-sm mb-3 block">Sustainability</span>
        <h2 class="section-title text-3xl md:text-5xl font-heading mb-16">Our Impact in Numbers</h2>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-10">
            <div class="text-center animate-on-scroll slide-up">
                <div class="text-5xl mb-4">🌳</div>
                <div class="text-4xl md:text-5xl font-bold font-heading text-accent mb-2"><span class="counter" data-target="{{ site.stats.treesPlanted }}">0</span>+</div>
                <div class="text-gray-300 font-medium">Trees Planted</div>
            </div>
            <div class="text-center animate-on-scroll slide-up" style="transition-delay: 100ms;">
                <div class="text-5xl mb-4">☁️</div>
                <div class="text-4xl md:text-5xl font-bold font-heading text-accent mb-2"><span class="counter" data-target="{{ site.stats.co2Offset }}">0</span> tons</div>
                <div class="text-gray-300 font-medium">CO₂ Offset</div>
            </div>
            <div class="text-center animate-on-scroll slide-up" style="transition-delay: 200ms;">
                <div class="text-5xl mb-4">🤝</div>
                <div class="text-4xl md:text-5xl font-bold font-heading text-accent mb-2"><span class="counter" data-target="{{ site.stats.conservationPartners }}">0</span>+</div>
                <div class="text-gray-300 font-medium">Conservation Partners</div>
            </div>
            <div class="text-center animate-on-scroll slide-up" style="transition-delay: 300ms;">
                <div class="text-5xl mb-4">😊</div>
                <div class="text-4xl md:text-5xl font-bold font-heading text-accent mb-2"><span class="counter" data-target="{{ site.stats.happyTravelers }}">0</span>+</div>
                <div class="text-gray-300 font-medium">Happy Travelers</div>
            </div>
        </div>
    </div>
</section>
