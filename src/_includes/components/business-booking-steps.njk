<section class="bg-gray-50 py-12 md:py-16" aria-labelledby="booking-steps-title">
  <div class="container mx-auto px-4">
    <div class="section-heading"><p class="eyebrow">How booking works</p><h2 id="booking-steps-title">Easy Steps to Your Trip</h2><p>A written process designed to reduce uncertainty before payment.</p></div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
      {% set steps = [
        ['1','Share requirements','Tell us destination, dates, travellers and preferences.'],
        ['2','Receive quotation','Review the itinerary, price basis and exclusions.'],
        ['3','Customize and confirm','Adjust hotel, vehicle and activities before paying.'],
        ['4','Receive vouchers','Get confirmed service details and trip-support contacts.']
      ] %}
      {% for step in steps %}<article class="rounded-2xl bg-white p-6 shadow-card"><span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary text-lg font-bold text-white">{{ step[0] }}</span><h3 class="mt-4 font-heading text-xl font-bold text-forest">{{ step[1] }}</h3><p class="mt-2 text-sm leading-6 text-gray-600">{{ step[2] }}</p></article>{% endfor %}
    </div>
    <div class="mt-8 text-center"><a href="{{ '/booking-process/' | url }}" class="font-bold text-primary">Read the complete booking process &rarr;</a></div>
  </div>
</section>
