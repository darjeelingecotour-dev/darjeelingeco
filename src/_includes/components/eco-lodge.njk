<section class="py-24 bg-white overflow-hidden border-y border-gray-100">
    <div class="container mx-auto px-4 mb-12">
        <div class="flex justify-between items-end">
            <div>
                <span class="section-badge text-yellow-500 font-medium tracking-wide uppercase text-sm mb-3 block flex items-center gap-2">
                    <span class="animate-pulse">✨</span> Partner With Us
                </span>
                <h2 class="section-title text-3xl md:text-5xl font-heading text-forest">Advertise Your Homestay</h2>
                <p class="section-subtitle text-gray-600 max-w-2xl text-lg mt-3">Showcase your property to thousands of travelers visiting Northeast India. Book an advertising slot below.</p>
            </div>
        </div>
    </div>
    
    <div class="marquee-wrapper relative flex overflow-x-hidden w-full group py-4">
        <!-- Overlay gradients for smooth fade on edges -->
        <div class="absolute top-0 bottom-0 left-0 w-16 md:w-32 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
        <div class="absolute top-0 bottom-0 right-0 w-16 md:w-32 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>

        <div class="animate-marquee flex whitespace-nowrap gap-6 pl-6 group-hover:[animation-play-state:paused]">
            {% for ad in advertisements %}
            <div class="ad-card flex-none w-[85vw] md:w-80 bg-gradient-to-br from-[#FFFBF0] to-white rounded-2xl overflow-hidden shadow-card hover:shadow-lg transition-all duration-300 border-2 border-yellow-200/60 relative group/card flex flex-col h-full transform hover:-translate-y-1">
                
                <!-- Gold Accent Header -->
                <div class="h-2 w-full bg-gradient-to-r from-yellow-400 to-yellow-600"></div>

                <div class="relative h-48 overflow-hidden bg-gray-100 flex items-center justify-center">
                    <div class="absolute inset-0 bg-black/40 z-10 group-hover/card:bg-black/20 transition-colors duration-300"></div>
                    <img src="{{ ad.image | url }}" alt="Advertisement Slot" class="w-full h-full object-cover grayscale opacity-60 group-hover/card:scale-110 transition-transform duration-700 ease-in-out" loading="lazy">
                    <div class="absolute top-3 right-3 z-20 bg-yellow-400 text-forest text-xs font-bold px-3 py-1 rounded-full shadow-md uppercase tracking-wider">
                        Available
                    </div>
                    <div class="absolute z-20 text-center text-white p-4">
                        <span class="block text-2xl font-bold drop-shadow-md">YOUR IMAGE</span>
                        <span class="block text-sm font-medium drop-shadow-md">HERE</span>
                    </div>
                    {% if ad.highlight %}
                    <div class="absolute bottom-3 left-3 z-20 bg-white/95 backdrop-blur px-2.5 py-1 rounded text-xs font-bold text-forest shadow-sm flex items-center gap-1">
                        <span class="text-yellow-500">★</span> {{ ad.highlight }}
                    </div>
                    {% endif %}
                </div>
                
                <div class="p-6 flex-grow flex flex-col whitespace-normal">
                    <div class="flex items-center gap-1 text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">
                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        {{ ad.location }}
                    </div>
                    
                    <h3 class="text-xl font-heading font-bold text-forest mb-2 leading-tight">{{ ad.name }}</h3>
                    <p class="text-sm font-medium text-primary mb-4">{{ ad.type }}</p>
                    
                    <div class="mt-auto border-t border-yellow-100 pt-4 flex justify-between items-center">
                        <div>
                            <span class="text-xs text-gray-500 block mb-0.5">Advertising Fee</span>
                            <span class="font-bold text-xl text-forest">{{ ad.price }}</span>
                            <span class="text-xs text-gray-500">/month</span>
                        </div>
                        <a href="/contact/" class="bg-yellow-400 text-forest font-bold text-sm px-4 py-2 rounded-lg hover:bg-yellow-500 transition shadow-sm flex items-center gap-1">
                            Book Slot
                        </a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>

        <!-- Duplicate for infinite scroll -->
        <div class="animate-marquee flex whitespace-nowrap gap-6 pl-6 group-hover:[animation-play-state:paused]" aria-hidden="true">
            {% for ad in advertisements %}
            <div class="ad-card flex-none w-[85vw] md:w-80 bg-gradient-to-br from-[#FFFBF0] to-white rounded-2xl overflow-hidden shadow-card hover:shadow-lg transition-all duration-300 border-2 border-yellow-200/60 relative group/card flex flex-col h-full transform hover:-translate-y-1">
                
                <div class="h-2 w-full bg-gradient-to-r from-yellow-400 to-yellow-600"></div>

                <div class="relative h-48 overflow-hidden bg-gray-100 flex items-center justify-center">
                    <div class="absolute inset-0 bg-black/40 z-10 group-hover/card:bg-black/20 transition-colors duration-300"></div>
                    <img src="{{ ad.image | url }}" alt="Advertisement Slot" class="w-full h-full object-cover grayscale opacity-60 group-hover/card:scale-110 transition-transform duration-700 ease-in-out" loading="lazy">
                    <div class="absolute top-3 right-3 z-20 bg-yellow-400 text-forest text-xs font-bold px-3 py-1 rounded-full shadow-md uppercase tracking-wider">
                        Available
                    </div>
                    <div class="absolute z-20 text-center text-white p-4">
                        <span class="block text-2xl font-bold drop-shadow-md">YOUR IMAGE</span>
                        <span class="block text-sm font-medium drop-shadow-md">HERE</span>
                    </div>
                    {% if ad.highlight %}
                    <div class="absolute bottom-3 left-3 z-20 bg-white/95 backdrop-blur px-2.5 py-1 rounded text-xs font-bold text-forest shadow-sm flex items-center gap-1">
                        <span class="text-yellow-500">★</span> {{ ad.highlight }}
                    </div>
                    {% endif %}
                </div>
                
                <div class="p-6 flex-grow flex flex-col whitespace-normal">
                    <div class="flex items-center gap-1 text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">
                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        {{ ad.location }}
                    </div>
                    
                    <h3 class="text-xl font-heading font-bold text-forest mb-2 leading-tight">{{ ad.name }}</h3>
                    <p class="text-sm font-medium text-primary mb-4">{{ ad.type }}</p>
                    
                    <div class="mt-auto border-t border-yellow-100 pt-4 flex justify-between items-center">
                        <div>
                            <span class="text-xs text-gray-500 block mb-0.5">Advertising Fee</span>
                            <span class="font-bold text-xl text-forest">{{ ad.price }}</span>
                            <span class="text-xs text-gray-500">/month</span>
                        </div>
                        <a href="/contact/" class="bg-yellow-400 text-forest font-bold text-sm px-4 py-2 rounded-lg hover:bg-yellow-500 transition shadow-sm flex items-center gap-1">
                            Book Slot
                        </a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
