<section class="border-b border-gray-100 bg-white py-7" aria-label="Why book with Safar Saathi">
  <div class="container mx-auto grid gap-4 px-4 sm:grid-cols-2 lg:grid-cols-4">
    {% set promises = [
      {title:'Written quote first',text:'Review the itinerary, inclusions and price basis before payment.'},
      {title:'No undisclosed fee',text:'Optional and payable-at-destination costs are identified clearly.'},
      {title:'Flexible choices',text:'Compare Budget, Comfort and Premium travel arrangements.'},
      {title:'Trip coordination',text:'Receive one point of contact for the confirmed itinerary.'}
    ] %}
    {% for item in promises %}<article class="rounded-2xl border border-primary-100 bg-primary-50 p-5"><div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary text-white" aria-hidden="true">✓</div><h2 class="font-heading text-xl font-bold text-forest">{{ item.title }}</h2><p class="mt-2 text-sm leading-6 text-gray-600">{{ item.text }}</p></article>{% endfor %}
  </div>
</section>

<section class="bg-forest py-12 text-white" aria-labelledby="winter-business-title">
  <div class="container mx-auto grid items-center gap-8 px-4 lg:grid-cols-[1fr_auto]">
    <div><p class="eyebrow !text-primary-300">Selected December 2026 and January 2027 dates</p><h2 id="winter-business-title" class="font-heading text-4xl font-bold">Winter offers with transparent conditions</h2><p class="mt-4 max-w-3xl text-white/75">Compare North Sikkim, Dooars and Kashmir plans with group size, hotel category, vehicle basis and optional costs stated before confirmation.</p></div>
    <a href="{{ '/offers/' | url }}" class="btn-primary">Explore Winter Offers</a>
  </div>
</section>

<section class="bg-white py-12 md:py-16" aria-labelledby="travel-style-title">
  <div class="container mx-auto px-4">
    <div class="section-heading"><p class="eyebrow">Choose your travel style</p><h2 id="travel-style-title">Budget, Comfort or Premium</h2><p>Start with the service level that suits the group. The exact quotation is based on live availability.</p></div>
    <div class="grid gap-6 md:grid-cols-3">
      <article class="rounded-2xl border border-gray-200 bg-white p-7 shadow-card"><span class="tag-pill">Best value</span><h3 class="mt-4 font-heading text-3xl font-bold text-forest">Budget</h3><ul class="mt-5 space-y-3 text-gray-600"><li>✓ Standard hotel or homestay</li><li>✓ Essential meal plan</li><li>✓ Shared transport where suitable</li><li>✓ Clear optional-cost list</li></ul><a href="{{ '/contact/#enquiry-form' | url }}" class="btn-secondary mt-7 w-full">Request Budget Quote</a></article>
      <article class="relative rounded-2xl border-2 border-primary bg-white p-7 shadow-card-hover"><span class="absolute right-5 top-5 rounded-full bg-primary px-3 py-1 text-xs font-bold text-white">POPULAR</span><h3 class="font-heading text-3xl font-bold text-forest">Comfort</h3><ul class="mt-5 space-y-3 text-gray-600"><li>✓ Better hotel category</li><li>✓ Breakfast and dinner</li><li>✓ Private vehicle where feasible</li><li>✓ More itinerary flexibility</li></ul><a href="{{ '/contact/#enquiry-form' | url }}" class="btn-primary mt-7 w-full">Request Comfort Quote</a></article>
      <article class="rounded-2xl border border-gray-200 bg-white p-7 shadow-card"><span class="tag-pill">Upgraded</span><h3 class="mt-4 font-heading text-3xl font-bold text-forest">Premium</h3><ul class="mt-5 space-y-3 text-gray-600"><li>✓ Premium accommodation</li><li>✓ Private transfers</li><li>✓ Selected activities</li><li>✓ Priority customization</li></ul><a href="{{ '/contact/#enquiry-form' | url }}" class="btn-secondary mt-7 w-full">Request Premium Quote</a></article>
    </div>
  </div>
</section>

<section class="bg-sage py-12 md:py-16" aria-labelledby="booking-steps-title">
  <div class="container mx-auto px-4"><div class="section-heading"><p class="eyebrow">Simple and accountable</p><h2 id="booking-steps-title">How booking works</h2></div>
    <ol class="grid gap-5 md:grid-cols-5">
      {% set steps = ['Share requirements','Receive written quote','Customize the plan','Confirm with deposit','Receive vouchers and support'] %}
      {% for step in steps %}<li class="rounded-2xl bg-white p-5 shadow-card"><span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-primary font-bold text-white">{{ loop.index }}</span><h3 class="mt-4 font-bold text-forest">{{ step }}</h3></li>{% endfor %}
    </ol>
    <div class="mt-8 text-center"><a href="{{ '/booking-process/' | url }}" class="font-bold text-primary">Read the complete booking process &rarr;</a></div>
  </div>
</section>

<section class="bg-white py-12 md:py-16" aria-labelledby="business-services-title">
  <div class="container mx-auto px-4"><div class="section-heading"><p class="eyebrow">More ways to travel</p><h2 id="business-services-title">Planning services for every group</h2></div>
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {% set services = [
        {title:'Custom Itineraries',text:'A destination plan with routes, budget questions and practical timings.',url:'/custom-itinerary/'},
        {title:'Fixed Departures',text:'Selected group dates with stated minimum participation and inclusions.',url:'/fixed-departures/'},
        {title:'Group Tours',text:'Family groups, senior travellers, clubs and educational journeys.',url:'/group-tours/'},
        {title:'Corporate Travel',text:'Offsites, incentive travel, hotel blocks and group transportation.',url:'/corporate-travel/'}
      ] %}
      {% for service in services %}<article class="flex h-full flex-col rounded-2xl border border-gray-100 bg-white p-6 shadow-card"><h3 class="font-heading text-2xl font-bold text-forest">{{ service.title }}</h3><p class="mt-3 text-gray-600">{{ service.text }}</p><a href="{{ service.url | url }}" class="mt-auto pt-6 font-bold text-primary">Explore {{ service.title }} &rarr;</a></article>{% endfor %}
    </div>
  </div>
</section>
