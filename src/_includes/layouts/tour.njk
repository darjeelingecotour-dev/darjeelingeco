---
layout: layouts/base.njk
---
<article class="tour-page">
    <header class="relative h-[60vh] min-h-[400px] flex items-end pb-12">
        <div class="absolute inset-0">
            <img src="{{ image }}" alt="{{ title }}" class="w-full h-full object-cover" loading="lazy">
            <div class="absolute inset-0 bg-hero-gradient-bottom"></div>
        </div>
        <div class="relative container mx-auto px-4 z-10 text-white">
            <span class="inline-block px-3 py-1 bg-primary text-white text-sm rounded-full mb-4">{{ region }}</span>
            <h1 class="text-4xl md:text-6xl font-heading mb-2">{{ title }}</h1>
        </div>
    </header>
    
    <div class="bg-sage py-4 border-b border-gray-200">
        <div class="container mx-auto px-4 flex flex-wrap gap-6 text-sm md:text-base">
            <div class="flex items-center gap-2"><span class="font-bold">⏱️ Duration:</span> {{ duration }}</div>
            <div class="flex items-center gap-2"><span class="font-bold">💰 Price:</span> ₹{{ price }}</div>
            <div class="flex items-center gap-2"><span class="font-bold">⭐ Rating:</span> {{ rating }}</div>
            <div class="flex items-center gap-2"><span class="font-bold">📍 Region:</span> {{ region }}</div>
        </div>
    </div>

    <div class="container mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="md:col-span-2 prose max-w-none">
            <div class="mb-6 flex flex-wrap gap-2">
                {% for tag in tags %}
                    <span class="tag-pill bg-gray-100 px-3 py-1 rounded text-sm text-gray-700">#{{ tag }}</span>
                {% endfor %}
            </div>
            
            <div class="bg-primary-50 p-6 rounded-lg mb-8">
                <h3 class="font-heading text-2xl mb-4 text-forest">Highlight</h3>
                <p class="text-lg">{{ highlight }}</p>
            </div>

            <div class="tour-content">
                {{ content | safe }}
            </div>
            
            <div class="mt-12 bg-white shadow-card rounded-lg p-8" id="inquire">
                <h3 class="font-heading text-2xl mb-6 text-forest">Inquire About This Tour</h3>
                <form action="https://formsubmit.co/ajax/darjeelingecotour@gmail.com" method="POST" class="grid grid-cols-1 sm:grid-cols-2 gap-6 inquiry-form" data-whatsapp="{{ site.whatsapp }}">
                    <input type="hidden" name="tour-name" value="{{ title }}">
                    <div><label class="form-label block mb-2 text-sm font-bold text-gray-700">Name</label><input type="text" name="name" required class="form-input w-full border border-gray-300 rounded p-3"></div>
                    <div><label class="form-label block mb-2 text-sm font-bold text-gray-700">Email</label><input type="email" name="email" required class="form-input w-full border border-gray-300 rounded p-3"></div>
                    <div><label class="form-label block mb-2 text-sm font-bold text-gray-700">Phone</label><input type="tel" name="phone" class="form-input w-full border border-gray-300 rounded p-3"></div>
                    <div><label class="form-label block mb-2 text-sm font-bold text-gray-700">Travel Dates</label><input type="text" name="dates" class="form-input w-full border border-gray-300 rounded p-3"></div>
                    <div><label class="form-label block mb-2 text-sm font-bold text-gray-700">Group Size</label><input type="number" name="group-size" min="1" class="form-input w-full border border-gray-300 rounded p-3"></div>
                    <div class="sm:col-span-2"><label class="form-label block mb-2 text-sm font-bold text-gray-700">Message</label><textarea name="message" rows="4" class="form-input w-full border border-gray-300 rounded p-3 resize-none"></textarea></div>
                    <div class="sm:col-span-2"><button type="submit" class="btn-primary bg-primary text-white px-6 py-3 rounded hover:bg-forest w-full transition font-bold">Send Inquiry</button></div>
                </form>
            </div>
        </div>
        
        <div class="md:col-span-1">
            <div class="bg-white shadow-card p-6 rounded-lg sticky top-24 border border-gray-100">
                <h3 class="font-heading text-2xl mb-4 text-forest">Book This Tour</h3>
                <div class="text-3xl text-primary font-bold mb-2">₹{{ price }}</div>
                <p class="text-gray-600 mb-6 pb-6 border-b border-gray-100">{{ duration }} • {{ region }}</p>
                <a href="#inquire" class="btn-primary block text-center bg-primary text-white px-4 py-3 rounded-full hover:bg-forest transition w-full mb-6 font-bold shadow-md">Request Quote</a>
                <h4 class="font-bold mb-3 text-forest">Includes:</h4>
                <ul class="list-disc pl-5 mb-6 text-sm text-gray-700 space-y-1">
                    <li>Accommodation in eco-lodges</li>
                    <li>Local experienced guide</li>
                    <li>Internal transport</li>
                    <li>Carbon offset for the trip</li>
                </ul>
                <h4 class="font-bold mb-3 text-forest">Excludes:</h4>
                <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
                    <li>Flights/Train to base location</li>
                    <li>Personal expenses</li>
                    <li>Travel insurance</li>
                </ul>
            </div>
        </div>
    </div>
</article>
