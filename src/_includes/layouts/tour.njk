---
layout: layouts/base.njk
---
<article class="tour-page">
  <header class="relative flex min-h-[480px] items-end overflow-hidden pb-12">
    <img src="{{ image | url }}" alt="{{ imageAlt or (title + ' tour package') }}" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high">
    <div class="absolute inset-0 bg-hero-gradient-bottom"></div>
    <div class="container relative z-10 mx-auto px-4 text-white">
      <nav class="mb-6 text-sm text-white/75" aria-label="Breadcrumb"><a href="{{ '/' | url }}">Home</a> / <a href="{{ '/tours/' | url }}">Packages</a> / <span>{{ title }}</span></nav>
      <span class="inline-block rounded-full bg-primary px-3 py-1 text-sm">{{ region }}</span>
      <h1 class="mt-4 max-w-4xl font-heading text-4xl font-bold md:text-6xl">{{ title }}</h1>
      {% if shortDescription %}<p class="mt-4 max-w-3xl text-lg text-white/85">{{ shortDescription }}</p>{% endif %}
    </div>
  </header>

  <div class="border-b border-gray-200 bg-sage py-4">
    <div class="container mx-auto flex flex-wrap gap-x-8 gap-y-3 px-4 text-sm md:text-base">
      <div><strong>Duration:</strong> {{ duration }}</div>
      {% if price %}<div><strong>Starting price:</strong> INR {{ price | numberFormat }} per person</div>{% else %}<div><strong>Price:</strong> Request current quote</div>{% endif %}
      <div><strong>Region:</strong> {{ region }}</div>
      {% if validity %}<div><strong>Validity:</strong> {{ validity }}</div>{% endif %}
    </div>
  </div>

  <div class="container mx-auto grid grid-cols-1 gap-10 px-4 py-12 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="min-w-0">
      {% if tags %}<div class="mb-7 flex flex-wrap gap-2" aria-label="Package topics">{% for tag in tags %}<span class="tag-pill">{{ tag }}</span>{% endfor %}</div>{% endif %}
      {% if highlight %}<div class="mb-8 rounded-2xl bg-primary-50 p-6"><h2 class="font-heading text-2xl font-bold text-forest">Package highlight</h2><p class="mt-3 text-lg text-gray-700">{{ highlight }}</p></div>{% endif %}
      <div class="tour-content prose max-w-none">{{ content | safe }}</div>

      {% include "components/package-tiers.njk" %}
<section class="mt-10 rounded-2xl border border-primary-100 bg-primary-50 p-7" aria-labelledby="pricing-promise">
        <h2 id="pricing-promise" class="font-heading text-2xl font-bold text-forest">Transparent Pricing Promise</h2>
        <p class="mt-3 text-gray-700">The confirmed written quotation will identify accommodation, room sharing, meals, transport, sightseeing, permits, taxes, optional activities and payable-at-destination charges. Safar Saathi will not add an undisclosed booking or service fee after written confirmation.</p>
      </section>

      <section class="mt-10 rounded-2xl bg-white p-8 shadow-card" id="inquire">
        <h2 class="font-heading text-3xl font-bold text-forest">Request the exact quote</h2>
        <p class="mt-3 text-gray-600">Share dates, pickup point, group size, room preference and travel style.</p>
        <form action="https://formsubmit.co/ajax/{{ site.email }}" method="POST" class="inquiry-form mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2" data-whatsapp="{{ site.whatsapp }}">
          <input type="hidden" name="tour-name" value="{{ title }}">
          <div><label class="form-label">Name</label><input class="form-input" name="name" required></div>
          <div><label class="form-label">Phone</label><input class="form-input" name="phone" required></div>
          <div><label class="form-label">Travel dates</label><input class="form-input" name="dates"></div>
          <div><label class="form-label">Group size</label><input class="form-input" type="number" min="1" name="group-size"></div>
          <div class="sm:col-span-2"><label class="form-label">Message</label><textarea class="form-input" rows="4" name="message"></textarea></div>
          <div class="sm:col-span-2"><button class="btn-primary w-full" type="submit">Send enquiry</button></div>
        </form>
      </section>
    </div>

    <aside>
      <div class="sticky top-32 rounded-2xl border border-gray-100 bg-white p-6 shadow-card">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-500">Starting from</p>
        {% if price %}<p class="mt-1 text-3xl font-bold text-primary">INR {{ price | numberFormat }}</p><p class="text-sm text-gray-500">per person, subject to stated basis</p>{% else %}<p class="mt-1 text-2xl font-bold text-primary">Request current quote</p>{% endif %}
        {% if priceBasis %}<p class="mt-4 rounded-xl bg-gray-50 p-4 text-sm text-gray-700"><strong>Price basis:</strong> {{ priceBasis }}</p>{% endif %}
        <a href="#inquire" class="btn-primary mt-6 w-full">Request Quote</a>
        {% if includes %}<h2 class="mt-7 font-bold text-forest">Included</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-gray-700">{% for item in includes %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
        {% if excludes %}<h2 class="mt-7 font-bold text-forest">Not included</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-gray-700">{% for item in excludes %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
        {% if payableAtDestination %}<h2 class="mt-7 font-bold text-forest">Payable at destination</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-gray-700">{% for item in payableAtDestination %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
      </div>
    </aside>
  </div>
</article>
