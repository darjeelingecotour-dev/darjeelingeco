---
layout: layouts/base.njk
ogType: article
---
<article>
  <header class="relative overflow-hidden bg-forest text-white">
    <img src="{{ image | url }}" width="1600" height="900" alt="{{ imageAlt or title }}" class="absolute inset-0 h-full w-full object-cover opacity-35">
    <div class="absolute inset-0 bg-gradient-to-r from-forest via-forest/85 to-forest/45"></div>
    <div class="container relative mx-auto px-4 py-20 md:py-28">
      <nav class="text-sm text-white/75" aria-label="Breadcrumb">
        <a href="{{ '/' | url }}" class="hover:text-white">Home</a>
        <span aria-hidden="true"> / </span>
        <a href="{{ '/blog/' | url }}" class="hover:text-white">Travel Blog</a>
      </nav>
      <p class="mt-8 text-sm font-bold uppercase tracking-widest text-primary-300">{{ category }}</p>
      <h1 class="mt-3 max-w-4xl font-heading text-4xl font-bold leading-tight md:text-6xl">{{ title }}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-white/80">{{ excerpt }}</p>
      <div class="mt-6 flex flex-wrap gap-4 text-sm text-white/70">
        <span>Published {{ displayDate }}</span>
        <span>{{ readingTime }} min read</span>
        <span>Reviewed {{ updatedDate }}</span>
      </div>
    </div>
  </header>

  <div class="container mx-auto grid gap-10 px-4 py-14 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="tour-content prose max-w-none">
{% if tags %}
<div class="mb-8 flex flex-wrap gap-2" aria-label="Article topics">
  {% for tag in tags %}
    <span class="tag-pill">{{ tag }}</span>
  {% endfor %}
</div>
{% endif %}

      {{ content | safe }}
    </div>
    <aside>
      <div class="sticky top-32 rounded-2xl border border-primary-100 bg-primary-50 p-6">
        <p class="text-sm font-bold uppercase tracking-wider text-primary">Plan this journey</p>
        <h2 class="mt-2 font-heading text-2xl font-bold text-forest">Want a transparent quote?</h2>
        <p class="mt-3 text-sm leading-6 text-gray-600">Share dates, group size, pickup point and hotel preference. The written quote will separate included, optional and payable-at-destination costs.</p>
        <a href="{{ relatedPackage | url }}" class="btn-primary mt-6 w-full">View related package</a>
        <a href="{{ '/contact/#enquiry-form' | url }}" class="btn-secondary mt-3 w-full">Request itinerary</a>
      </div>
    </aside>
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | dump | safe }},
    "description": {{ metaDescription | dump | safe }},
    "image": "{{ site.url }}{{ image | url }}",
    "datePublished": "{{ publishedDate }}",
    "dateModified": "{{ updatedDate }}",
    "author": {"@type": "Organization", "name": "Safar Saathi"},
    "publisher": {"@type": "Organization", "name": "Safar Saathi", "url": "{{ site.url }}"},
    "mainEntityOfPage": "{{ site.url }}{{ page.url | url }}"
  }
  </script>
</article>