{% include "components/hero.njk" %}
{% include "components/impact-stats.njk" %}

<section class="py-24 bg-gray-50">
    <div class="container mx-auto px-4">
        <div class="text-center mb-16">
            <span class="section-badge text-primary font-medium tracking-wide uppercase text-sm mb-3 block">Our Collection</span>
            <h2 class="section-title text-3xl md:text-5xl font-heading text-forest mb-4">Featured Tours</h2>
            <p class="section-subtitle text-gray-600 max-w-2xl mx-auto text-lg">Handpicked itineraries showcasing the best of the Himalayas and the plains.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            {% for tour in tours %}
                {% include "components/tour-card.njk" %}
            {% endfor %}
        </div>
        
        <div class="text-center mt-16">
            <a href="/tours/" class="btn-outline inline-block border-2 border-primary text-primary px-10 py-4 rounded-full hover:bg-primary hover:text-white transition font-bold text-lg shadow-sm">View All Tours</a>
        </div>
    </div>
</section>

